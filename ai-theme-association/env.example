# Copy to .env and fill in.  .env is gitignored; this file is not, so no real
# secret ever belongs here.
#
#   cp env.example .env
#   $EDITOR .env
#   set -a; source .env; set +a

# REQUIRED for any SEC fetch. src/utils/config.py:sec_headers() reads this and raises
# if it is unset. SEC requires a real contact address; a generic UA gets 403s.
# KEEP THE QUOTES -- the value contains spaces, and an unquoted `source .env` would try
# to run the second word as a command.
SEC_USER_AGENT="Your Name your.email@example.com"

# Only needed for `make classify`. Everything else runs without it.
ANTHROPIC_API_KEY=

# Only needed for `make news-repull`.
AV_KEY=
